+/// Benchmark-only metrics; CPU timers overlap their enclosing decode/poll timers.
+#[derive(Debug, Clone)]
+pub(crate) struct ScanProbeMetrics {
+    pub prepare_filters_wall: Time,
+    pub prepare_filters_cpu: Time,
+    pub build_reader_wall: Time,
+    pub build_reader_cpu: Time,
+    pub row_filter_cpu: Time,
+    pub scan_poll_wall: Time,
+    pub scan_poll_cpu: Time,
+    pub decode_wall: Time,
+    pub decode_cpu: Time,
+    pub range_read_wall: Time,
+    pub range_read_cpu: Time,
+    pub first_batch_read_wall: Time,
+    pub scan_first_batch_wall: Time,
+    pub range_read_calls: Count,
+    pub range_read_ranges: Count,
+    pub data_bytes_requested: Count,
+    pub first_batch_read_calls: Count,
+    pub scan_streams: Count,
+    pub scan_output_streams: Count,
+}
+
+impl ScanProbeMetrics {
+    fn new(builder: &MetricBuilder<'_>, partition: usize) -> Self {
+        let time = |name| builder.clone().subset_time(name, partition);
+        let count = |name| builder.clone().counter(name, partition);
+        Self {
+            prepare_filters_wall: time("probe_prepare_filters_wall"),
+            prepare_filters_cpu: time("probe_prepare_filters_cpu"),
+            build_reader_wall: time("probe_build_reader_wall"),
+            build_reader_cpu: time("probe_build_reader_cpu"),
+            row_filter_cpu: time("probe_row_filter_cpu"),
+            scan_poll_wall: time("probe_scan_poll_wall"),
+            scan_poll_cpu: time("probe_scan_poll_cpu"),
+            decode_wall: time("probe_decode_wall"),
+            decode_cpu: time("probe_decode_cpu"),
+            range_read_wall: time("probe_range_read_wall"),
+            range_read_cpu: time("probe_range_read_cpu"),
+            first_batch_read_wall: time("probe_first_batch_read_wall"),
+            scan_first_batch_wall: time("probe_scan_first_batch_wall"),
+            range_read_calls: count("probe_range_read_calls"),
+            range_read_ranges: count("probe_range_read_ranges"),
+            data_bytes_requested: builder
+                .clone()
+                .with_category(MetricCategory::Bytes)
+                .counter("probe_data_bytes_requested", partition),
+            first_batch_read_calls: count("probe_first_batch_read_calls"),
+            scan_streams: count("probe_scan_streams"),
+            scan_output_streams: count("probe_scan_output_streams"),
+        }
+    }
 }
 
