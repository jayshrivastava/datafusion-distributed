+//! Benchmark-only probes for separating polling CPU from elapsed I/O time.
+
+use std::future::{Future, poll_fn};
+use std::marker::PhantomData;
+use std::pin::pin;
+use std::rc::Rc;
+use std::time::Duration;
+
+use rustix::time::{ClockId, clock_gettime};
+
+use super::Time;
+
+fn thread_cpu_time() -> Duration {
+    let now = clock_gettime(ClockId::ThreadCPUTime);
+    Duration::new(now.tv_sec as u64, now.tv_nsec as u32)
+}
+
+/// Records thread CPU only within a synchronous scope. Must not cross an await.
+pub struct ThreadCpuTimer {
+    metric: Time,
+    started: Duration,
+    _not_send: PhantomData<Rc<()>>,
+}
+
+impl ThreadCpuTimer {
+    /// Start a CPU timer on the current thread.
+    pub fn start(metric: &Time) -> Self {
+        Self {
+            metric: metric.clone(),
+            started: thread_cpu_time(),
+            _not_send: PhantomData,
+        }
+    }
+}
+
+impl Drop for ThreadCpuTimer {
+    fn drop(&mut self) {
+        self.metric
+            .add_duration(thread_cpu_time().saturating_sub(self.started));
+    }
+}
+
+/// Times the whole await and the CPU in its polls, not background transport tasks.
+pub async fn timed_future<F: Future>(future: F, wall: Time, cpu: Time) -> F::Output {
+    let _wall = wall.timer();
+    let mut future = pin!(future);
+    poll_fn(move |cx| {
+        let _cpu = ThreadCpuTimer::start(&cpu);
+        future.as_mut().poll(cx)
+    })
+    .await
+}
